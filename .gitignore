# Rust build outputs
/target/
# The source-class fixture is a real crate that gets compiled during tests, so it
# grows its own target/ that the root-anchored rule above does not cover.
fixtures/**/target/
**/*.rs.bk

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Personal scratch — not for tracked content
docs/dev-notes/
docs/plans/
**/.papercuts.jsonl

# Cairn runtime artifacts
.cairn/

# Code Briefcase V1 (Python) runtime artifacts — V1 still operates on this repo for dogfooding
.code-briefcase/
.code-briefcaseignore

# macOS metadata
._*
.Spotlight-V100
.Trashes

# Environment / secrets
.env
.env.local
.env.*.local
